# 실제 값은 main_project/.env에 직접 입력. 이 파일에 비밀값을 저장하지 마세요.
DATABASE_URL=
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro4
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=30

# 초기 개발 예산. 본 비교 전에 모든 구조의 질문 전체 예산을 고정하세요.
MAX_TOOL_CALLS=24
MAX_MODEL_CALLS=20
MAX_ELAPSED_SECONDS=300
DB_STATEMENT_TIMEOUT_MS=10000
MAX_CONTEXT_CHARS=100000
EXPERIMENT_DATE=2026-10-13

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sbiz_main_project
EVAL_DATASET_NAME=sbiz_eval_36
# OpenAI 채점 키는 LangSmith Provider secrets에 별도 등록. 로컬 답변 모델은 Upstage.
